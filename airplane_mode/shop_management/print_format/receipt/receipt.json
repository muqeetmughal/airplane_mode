 "html": "<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n<style>\n\nbody{\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial;\n    background:#f6f7fb;\n    padding:30px;\n    color:#333;\n}\n\n.receipt-card{\n    max-width:700px;\n    margin:auto;\n    background:white;\n    border-radius:10px;\n    box-shadow:0 8px 25px rgba(0,0,0,0.08);\n    overflow:hidden;\n}\n\n.header{\n    background:#1f2937;\n    color:white;\n    padding:25px 30px;\n}\n\n.header h1{\n    margin:0;\n    font-size:22px;\n    letter-spacing:.5px;\n}\n\n.header .meta{\n    margin-top:8px;\n    font-size:13px;\n    opacity:.9;\n}\n\n.section{\n    padding:25px 30px;\n}\n\n.info-grid{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:20px;\n}\n\n.info-box{\n    background:#f8fafc;\n    padding:15px;\n    border-radius:6px;\n    font-size:14px;\n}\n\n.label{\n    font-size:12px;\n    color:#6b7280;\n    margin-bottom:3px;\n}\n\n.value{\n    font-weight:600;\n}\n\n.table{\n    width:100%;\n    border-collapse:collapse;\n    margin-top:20px;\n}\n\n.table th{\n    text-align:left;\n    font-size:13px;\n    color:#6b7280;\n    padding-bottom:10px;\n}\n\n.table td{\n    padding:12px 0;\n    border-top:1px solid #eee;\n}\n\n.total-box{\n    margin-top:20px;\n    padding-top:15px;\n    border-top:2px solid #e5e7eb;\n    display:flex;\n    justify-content:space-between;\n    font-size:18px;\n    font-weight:bold;\n}\n\n.footer{\n    text-align:center;\n    font-size:12px;\n    color:#9ca3af;\n    padding:20px;\n    border-top:1px solid #eee;\n}\n\n</style>\n</head>\n\n<body>\n\n<div class=\"receipt-card\">\n\n<div class=\"header\">\n    <h1>Rent Payment Receipt</h1>\n    <div class=\"meta\">\n        Receipt #: {{ doc.receipt_number }} <br>\n        Date: {{ frappe.utils.formatdate(doc.payment_date) }}\n    </div>\n</div>\n\n<div class=\"section\">\n\n<div class=\"info-grid\">\n\n<div class=\"info-box\">\n<div class=\"label\">Tenant</div>\n<div class=\"value\">{{ doc.tenant_name }}</div>\n</div>\n\n<div class=\"info-box\">\n<div class=\"label\">Shop</div>\n<div class=\"value\">{{ doc.shop_name }}</div>\n</div>\n\n<div class=\"info-box\">\n<div class=\"label\">Airport</div>\n<div class=\"value\">{{ doc.airport }}</div>\n</div>\n\n<div class=\"info-box\">\n<div class=\"label\">Status</div>\n<div class=\"value\">{{ doc.status }}</div>\n</div>\n\n</div>\n\n<table class=\"table\">\n\n<thead>\n<tr>\n<th>Description</th>\n<th style=\"text-align:right\">Amount</th>\n</tr>\n</thead>\n\n<tbody>\n<tr>\n<td>Monthly Rent Payment</td>\n<td style=\"text-align:right\">\n{{ frappe.format_value(doc.rent_amount, \"Currency\") }}\n</td>\n</tr>\n</tbody>\n\n</table>\n\n<div class=\"total-box\">\n<span>Total Paid</span>\n<span>{{ frappe.format_value(doc.rent_amount, \"Currency\") }}</span>\n</div>\n\n</div>\n\n<div class=\"footer\">\nThis is a computer generated receipt. Signature not required.\n</div>\n\n</div>\n\n</body>\n</html>",
